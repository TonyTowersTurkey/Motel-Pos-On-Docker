# Motel Occupancy Django - Environment Template
# Copy to .env and fill in your actual values

# Application (local development defaults)
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
TIME_ZONE=America/Puerto_Rico

# Required Bearer token for POST /api/webhooks/room-pulse
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROOM_PULSE_WEBHOOK_TOKEN=replace-with-a-long-random-token
# Keep enabled outside local development.
ROOM_PULSE_REQUIRE_HTTPS=true

# When running behind the stack Caddy in production ensure the webhook URL
# uses HTTPS and set `ROOM_PULSE_WEBHOOK_TOKEN` to a long secret. The detector
# and Room Pulse must use the same hostnames in production so Caddy routing
# accepts and terminates TLS correctly.

# Database (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=motel_occupancy
DB_USER=motel
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_REQUIRED=false
# Required with more than one web worker so SSE updates reach every browser.
SSE_REDIS_URL=redis://redis:6379/2

# Logging
LOG_LEVEL=INFO
