# Copy to .env.production, replace every CHANGE_ME value, and keep it out of Git.

# Public/LAN address used by Caddy. An IP address or internal name receives a
# Caddy local certificate; install Caddy's root CA on staff and detector devices.
SITE_ADDRESS=https://motel-pos.example.internal
APP_DOMAIN=motel-pos.example.internal

# Django
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=motel-pos.example.internal,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://motel-pos.example.internal
TIME_ZONE=America/Puerto_Rico
LOG_LEVEL=INFO
WEB_CONCURRENCY=4

# Room detector webhook
ROOM_PULSE_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ROOM_PULSE_REQUIRE_HTTPS=true

# PostgreSQL. POSTGRES_PASSWORD is mapped to Django's DB_PASSWORD by Compose.
POSTGRES_DB=motel_occupancy
POSTGRES_USER=motel
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD
DB_ENGINE=django.db.backends.postgresql

# Optional initial operational login. Run the documented bootstrap command after
# deployment; passwords are not created automatically during every restart.
MOTEL_CASHIER_USERNAME=cashier
MOTEL_CASHIER_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_CASHIER_PASSWORD

# Container resource starting points
APP_CPUS=4
APP_MEMORY=4g
POSTGRES_CPUS=2
POSTGRES_MEMORY=4g
REDIS_CPUS=1
REDIS_MEMORY=512m
PROXY_CPUS=1
PROXY_MEMORY=512m

# Optional sister camera/TensorFlow container (deploy with --detector)
DETECTOR_IMAGE=registry.example.internal/room-detector:CHANGE_ME_TAG
CAMERA_URL=rtsp://CHANGE_ME
DETECTOR_WEBHOOK_URL=https://motel-pos.example.internal/api/webhooks/room-pulse/
DETECTOR_MODEL_DIR=./detector-models
DETECTOR_MODEL_PATH=/models/model
DETECTOR_CPUS=8
DETECTOR_MEMORY=12g
