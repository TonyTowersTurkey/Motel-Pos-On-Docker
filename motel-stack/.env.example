## Shared stack environment template
# Copy to .env and fill secrets. Keep out of VCS.

# Networking / hostnames (production)
SITE_ADDRESS=https://example.internal
MOTEL_HOSTNAME=motel-pos.example.internal
ROOMPULSE_HOSTNAME=garage.example.internal

# Postgres bootstrap (one container creates the Motel DB; extra DB/user are created by init script)
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MOTEL_POSTGRES_DB=motel_occupancy
MOTEL_POSTGRES_USER=motel
ROOM_POSTGRES_DB=room_pulse
ROOM_POSTGRES_USER=roompulse
ROOM_POSTGRES_PASSWORD=CHANGE_ME_ROOM_POSTGRES_PASSWORD

# Redis
REDIS_PASSWORD=

# Motel POS specific
MOTEL_SECRET_KEY=CHANGE_ME_MOTEL_SECRET
ROOM_PULSE_WEBHOOK_TOKEN=CHANGE_ME_WEBHOOK_TOKEN

# Resource hints (adjust in production .env)
APP_CPUS=2
APP_MEMORY=2g
POSTGRES_CPUS=1
POSTGRES_MEMORY=2g
REDIS_CPUS=0.5
REDIS_MEMORY=256m

# Optional production image overrides. Leave empty for the GHCR :latest defaults.
# Example: ghcr.io/tonytowersturkey/motel-pos:v1.0.0
MOTEL_POS_IMAGE=
# Example: ghcr.io/tonytowersturkey/room-pulse:v1.0.0
ROOM_PULSE_IMAGE=
