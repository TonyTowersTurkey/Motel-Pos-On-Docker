APP_NAME="Garage Door Detection"
APP_ENV=local
DATABASE_URL=sqlite:///./local.db
DATABASE_CONNECT_MAX_ATTEMPTS=10
DATABASE_CONNECT_RETRY_SECONDS=2
SQLITE_BUSY_TIMEOUT_MS=30000
MEDIA_ROOT=media
UNCERTAIN_SAMPLE_DIR=media/uncertain_samples
CAMERA_SNAPSHOT_DIR=media/camera_snapshots
CAMERA_CAPTURE_DIR=media/camera_captures
TRAINING_CROP_DIR=media/training_crops

# In-process background workers. Keep each worker enabled in only one web process.
SNAPSHOT_SCHEDULER_ENABLED=true
INFERENCE_WORKER_ENABLED=true
ROOM_PULSE_WORKER_ENABLED=true

# For Docker production, disable in-process scheduler/workers in the web service
# and run them as dedicated one-off services to avoid duplicate workers in
# multi-replica or restart scenarios. Example overrides in compose:
#   SNAPSHOT_SCHEDULER_ENABLED=false
#   INFERENCE_WORKER_ENABLED=false
#   ROOM_PULSE_WORKER_ENABLED=false

# Automatic garage-door classification.
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MODEL_PATH=classificationModels/yologarageclassify_v0.2.pt
CLASSIFICATION_CACHE_DIR=media/model_cache
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_CONFIRMATION_COUNT=3
CLASSIFICATION_POLL_SECONDS=2
CLASSIFICATION_BATCH_SIZE=16
CLASSIFICATION_MAX_ATTEMPTS=3

# UniFi Protect. Remote mode is used now; local mode is scaffolded for later.
UNIFI_CONNECTION_MODE=remote
UNIFI_API_KEY=replace-with-api-key
UNIFI_CONSOLE_ID=replace-with-console-id
UNIFI_REMOTE_BASE_URL=https://api.ui.com

# Later, set mode=local and point this at the local Protect integration API.
# Example: https://192.168.1.10/proxy/protect/integration
UNIFI_LOCAL_BASE_URL=
UNIFI_LOCAL_API_KEY=
UNIFI_VERIFY_SSL=true
UNIFI_SNAPSHOT_HIGH_QUALITY=true
UNIFI_TIMEOUT_SECONDS=15
